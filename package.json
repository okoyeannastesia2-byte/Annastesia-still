{
  "name": "still-calm-coloring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run pages && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "pages": "esbuild scripts/prerender-pages.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/prerender.mjs --log-level=warning && node node_modules/.cache/prerender.mjs"
  },
  "dependencies": {
    "idb-keyval": "6.2.1",
    "perfect-freehand": "1.2.2",
    "polygon-clipping": "^0.15.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.20.5",
    "esbuild": "0.21.5"
  }
}